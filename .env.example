# =====================================================
# ALTIN TAKİP UYGULAMASI - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================
# Bu dosyayı kopyalayıp .env olarak kaydedin:
#   cp .env.example .env
# Ardından kendi değerlerinizi girin.

# ---- Uygulama ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL Veritabanı ----
# Render PostgreSQL servisinden otomatik inject edilir.
# Local geliştirme için kendi PostgreSQL bağlantı URL'nizi girin:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/gold_tracker
DATABASE_URL=

# ---- Temel URL (E-posta doğrulama linkleri için) ----
# Geliştirme:   http://localhost:3000
# Production:   https://alan-adiniz.onrender.com
BASE_URL=http://localhost:3000

# ---- JWT Güvenlik Anahtarı ----
# Güçlü rastgele değer girin: openssl rand -hex 64
JWT_SECRET=degistirmeniz-gereken-guclu-bir-secret

# ---- SMTP E-posta Ayarları (Opsiyonel) ----
# Boş bırakılırsa Ethereal test servisi kullanılır.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
